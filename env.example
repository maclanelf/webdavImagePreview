# WebDAV 配置
# 将此文件复制为 .env.local 并填入你的实际配置

# WebDAV服务器URL (必填)
WEBDAV_URL=https://your-webdav-server.com

# WebDAV用户名 (必填)
WEBDAV_USERNAME=your-username

# WebDAV密码 (必填)
WEBDAV_PASSWORD=your-password

# WebDAV图片/视频目录路径 (可选，默认为根目录)
WEBDAV_MEDIA_PATH=/photos

# MySQL配置文件路径（本地开发可直接使用 data/mysql-config.json）
MYSQL_CONFIG_FILE=./data/mysql-config.json


